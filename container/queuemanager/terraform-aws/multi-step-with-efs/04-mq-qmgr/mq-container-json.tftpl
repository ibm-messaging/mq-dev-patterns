[
    {
      "image": "icr.io/ibm-messaging/mq:latest",
      "cpu": 1024,
      "memory": 2048,
      "name": "${MQ_CONTAINER_NAME}",
      "networkMode": "awsvpc",
      "portMappings": [
        {
          "containerPort": ${MQ_HTTP_PORT},
          "hostPort": ${MQ_HTTP_PORT}
        },
        {
            "containerPort": ${MQ_MQI_PORT},
            "hostPort": ${MQ_MQI_PORT}
        }
      ],
      "environment": ${jsonencode([for env_key, env_value in ENVVARS : { name = env_key, value = env_value }])},
      "secrets": [
        {
          "name"      : "MQ_APP_PASSWORD",
          "valueFrom" : "${MQ_SECRET_ARN}:appPassword::"
        },
        {
          "name"      : "MQ_ADMIN_PASSWORD",
          "valueFrom" : "${MQ_SECRET_ARN}:adminPassword::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-region": "${REGION}",
          "awslogs-stream-prefix": "mqdevex-terraform",
          "awslogs-group": "${LOG_GROUP_NAME}"
        }
      },
      "mountPoints": [
        {
          "containerPath": "/mnt/mqm",
          "sourceVolume": "efs-volume",
          "readOnly" : false
        }
      ]
    }
]
