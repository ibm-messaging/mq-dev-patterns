{
  "author": "MQ Developer Experience",
  "name": "sample",
  "version": "0.0.1",
  "description": "Sample Code Engine, Serverless, Node.js MQ Client app",
  "main": "server.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ibm-messaging/mq-dev-patterns"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "axios": "^1.21.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "ibmmq": "^2.1.9",
    "morgan": "^1.12.1",
    "uuid": "^14.0.3"
  },
  "overrides": {
    "basic-ftp": "^6.2.6",
    "qs": "^6.17.1"
  },
  "scripts": {
    "start": "node server.js",
    "debug": "DEBUG=mqapp* node server.js",
    "format": "prettier --write \"**/*.js\"",
    "format:diff": "prettier --check \"**/*.js\"",
    "prepare": "cd ../../.. && (husky ibm-messaging-mq-cloud-showcase-app/.husky || true)"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.js": "prettier --write"
  },
  "prettier": {
    "bracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "allowScripts": {
    "husky": true,
    "ibmmq": true
  },
  "type": "commonjs"
}
