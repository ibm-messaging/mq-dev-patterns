{
  "name": "ibm-mq-demo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": "git@github.com:ibm-messaging/mq-dev-patterns.git",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci-check": "npm run format:diff",
    "clean": "rm -rf node_modules && npm ci",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,scss,css,md}\"",
    "format:diff": "prettier --check \"**/*.{ts,tsx,js,jsx,scss,css,md}\"",
    "format:staged": "prettier --write",
    "prepare": "cd ../../.. && (husky ibm-messaging-mq-cloud-showcase-app/.husky || true)"
  },
  "dependencies": {
    "@carbon/charts": "1.27.25",
    "@carbon/charts-react": "1.27.25",
    "@carbon/colors": "^11.62.0",
    "@carbon/ibm-products": "^2.102.0",
    "@carbon/react": "1.120.0",
    "@xyflow/react": "^12.12.1",
    "axios": "^1.21.0",
    "js-cookie": "^3.0.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/js-cookie": "^3.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,scss,css,md}": "prettier --write"
  },
  "prettier": {
    "bracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "allowScripts": {
    "@carbon/charts": true,
    "@carbon/charts-react": true,
    "@carbon/colors": true,
    "@carbon/feature-flags": true,
    "@carbon/grid": true,
    "@carbon/icon-helpers": true,
    "@carbon/icons-react": true,
    "@carbon/layout": true,
    "@carbon/motion": true,
    "@carbon/react": true,
    "@carbon/styles": true,
    "@carbon/themes": true,
    "@carbon/type": true,
    "@carbon/utilities": true,
    "@carbon/utils-position": true,
    "@ibm/plex": true,
    "@ibm/plex-mono": true,
    "@ibm/plex-sans": true,
    "@ibm/plex-sans-arabic": true,
    "@ibm/plex-sans-devanagari": true,
    "@ibm/plex-sans-hebrew": true,
    "@ibm/plex-sans-thai": true,
    "@ibm/plex-sans-thai-looped": true,
    "@ibm/plex-serif": true,
    "@parcel/watcher": true,
    "fsevents": true
  }
}
