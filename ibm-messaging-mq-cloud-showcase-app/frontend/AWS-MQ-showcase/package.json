{
  "name": "ibm-mq-demo",
  "version": "0.0.0",
  "private": true,
  "repository": "git@github.com:ibm-messaging/mq-dev-patterns.git",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "ci-check": "yarn format:diff",
    "clean": "yarn cache clean && yarn install",
    "format": "prettier --write \"**/*.{js,jsx,md,scss}\"",
    "format:diff": "prettier --list-different \"**/*.{js,jsx,md,scss}\"",
    "format:staged": "prettier --write"
  },
  "dependencies": {
    "@carbon/charts": "1.27.18",
    "@carbon/charts-react": "1.27.18",
    "@carbon/react": "1.113.0",
    "@xyflow/react": "^12",
    "axios": "1.18.0",
    "d3": "7.6.1",
    "js-cookie": "^3.0.5",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "uuid": "^9.0.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "7.5.0",
    "@vitejs/plugin-react": "^6",
    "husky": "1.3.1",
    "lint-staged": "8.1.5",
    "prettier": "1.17.0",
    "sass": "^1.70.0",
    "vite": "^8"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -e $HUSKY_GIT_PARAMS",
      "pre-commit": "lint-staged"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "prettier --write",
      "git add"
    ],
    "*.{scss,css}": [
      "prettier --write",
      "git add"
    ],
    "*.md": [
      "prettier --write",
      "git add"
    ]
  },
  "prettier": {
    "jsxBracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
