{
  "name": "ibm-mq-demo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=20"
  },
  "repository": "git@github.com:ibm-messaging/mq-dev-patterns.git",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --port 3000",
    "start": "vite --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "ci-check": "npm run format:diff",
    "clean": "rm -rf node_modules && npm install",
    "format": "prettier --write \"**/*.{js,jsx,scss,css,md}\"",
    "format:diff": "prettier --check \"**/*.{js,jsx,scss,css,md}\"",
    "format:staged": "prettier --write",
    "prepare": "cd ../../.. && husky ibm-messaging-mq-cloud-showcase-app/frontend/AWS-MQ-showcase/.husky"
  },
  "dependencies": {
    "@carbon/charts": "1.27.18",
    "@carbon/charts-react": "1.27.18",
    "@carbon/react": "1.113.0",
    "@xyflow/react": "^12",
    "axios": "1.18.0",
    "js-cookie": "^3.0.5",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "uuid": "^9.0.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19",
    "@commitlint/config-conventional": "^19",
    "@vitejs/plugin-react": "^6",
    "husky": "^9",
    "lint-staged": "^15",
    "prettier": "^3",
    "sass": "^1.70.0",
    "vite": "^8"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,scss,css,md}": "prettier --write"
  },
  "prettier": {
    "bracketSameLine": true,
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
