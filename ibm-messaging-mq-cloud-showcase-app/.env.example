# Copy this file to .env and fill in the values. Do not commit .env.
#   cp .env.example .env

# MQ user passwords (used by docker compose and cdk)
APP_PASSWORD=
ADMIN_PASSWORD=

# Coding challenge mode (build-time, baked into the frontend bundle).
# Set to true, then rebuild: npm start / docker compose up --build / cdk deploy
# Unset, empty or anything other than "true" means off.
REACT_APP_IS_FOR_CODING_CHALLENGE=false
